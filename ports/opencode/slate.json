{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "purple",
      "green",
      "blue",
      "orange",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.purple.200",
      "action": {
        "primary": {
          "base": "$hue.neutral.100",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.900",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$hue.purple.200",
          "$hovered": "$hue.neutral.100"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.100",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.300"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$hue.neutral.900"
      },
      "feedback": {
        "error": {
          "base": "$hue.neutral.900"
        },
        "warning": {
          "base": "$hue.neutral.900"
        },
        "success": {
          "base": "$hue.neutral.900"
        },
        "info": {
          "base": "$hue.neutral.900"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.500"
    },
    "scrollbar": {
      "base": "$hue.neutral.400"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.blue.300",
        "hunkHeader": "$hue.blue.300"
      },
      "background": {
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.400",
        "removed": "$hue.red.400"
      },
      "lineNumber": {
        "text": "$hue.neutral.300",
        "background": {
          "added": "#c9dfce",
          "removed": "#edd5d8"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.300",
      "keyword": "$hue.red.200",
      "function": "$hue.yellow.200",
      "variable": "$hue.neutral.100",
      "string": "$hue.green.200",
      "number": "$hue.accent.400",
      "type": "$hue.interactive.200",
      "operator": "$hue.neutral.100",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.interactive.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.accent.400",
      "code": "$hue.yellow.200",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.accent.400",
      "strong": "$hue.neutral.100",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.accent.400",
      "image": "$hue.interactive.200",
      "imageText": "$hue.accent.400",
      "codeBlock": "$hue.neutral.100"
    },
    "@dialog": {
      "background": {
        "base": "$hue.neutral.800",
        "action": {
          "primary": {
            "$hovered": "$hue.neutral.700"
          }
        }
      }
    }
  },
