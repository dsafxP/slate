// Slate Light
themes {
    slate-light {
        text_unselected {
            base 29 27 29        // #1d1b1d  foreground
            background 243 243 244  // #f3f3f4  surface
            emphasis_0 147 88 94    // #93585e  error
            emphasis_1 83 123 90    // #537b5a  success/strings
            emphasis_2 135 117 65   // #877541  modified/warning
            emphasis_3 119 92 143   // #775c8f  magenta
        }
        text_selected {
            base 29 27 29        // #1d1b1d
            background 230 229 231  // #e6e5e7  hover
            emphasis_0 147 88 94    // #93585e
            emphasis_1 83 123 90    // #537b5a
            emphasis_2 135 117 65   // #877541
            emphasis_3 119 92 143   // #775c8f
        }
        ribbon_selected {
            base 255 255 255     // #ffffff
            background 91 120 165   // #5b78a5  pane.focused_border / accent blue
            emphasis_0 196 132 139  // #c4848b  bright red
            emphasis_1 107 162 121  // #6ba279  bright green
            emphasis_2 155 143 75   // #9b8f4b  bright yellow
            emphasis_3 255 255 255  // #ffffff
        }
        ribbon_unselected {
            base 29 27 29        // #1d1b1d
            background 184 181 188  // #b8b5bc  outline/borders
            emphasis_0 147 88 94    // #93585e
            emphasis_1 83 123 90    // #537b5a
            emphasis_2 135 117 65   // #877541
            emphasis_3 109 96 122   // #6d607a  muted text
        }
        table_title {
            base 122 104 141     // #7a688d  accent (border.selected)
            background 0
            emphasis_0 147 88 94    // #93585e
            emphasis_1 83 123 90    // #537b5a
            emphasis_2 135 117 65   // #877541
            emphasis_3 119 92 143   // #775c8f
        }
        table_cell_unselected {
            base 29 27 29        // #1d1b1d
            background 243 243 244  // #f3f3f4
            emphasis_0 147 88 94    // #93585e
            emphasis_1 83 123 90    // #537b5a
            emphasis_2 135 117 65   // #877541
            emphasis_3 119 92 143   // #775c8f
        }
        table_cell_selected {
            base 29 27 29        // #1d1b1d
            background 230 229 231  // #e6e5e7  hover
            emphasis_0 147 88 94    // #93585e
            emphasis_1 83 123 90    // #537b5a
            emphasis_2 135 117 65   // #877541
            emphasis_3 119 92 143   // #775c8f
        }
        list_unselected {
            base 29 27 29        // #1d1b1d
            background 243 243 244  // #f3f3f4
            emphasis_0 147 88 94    // #93585e
            emphasis_1 83 123 90    // #537b5a
            emphasis_2 135 117 65   // #877541
            emphasis_3 119 92 143   // #775c8f
        }
        list_selected {
            base 255 255 255     // #ffffff
            background 91 120 165   // #5b78a5  accent blue
            emphasis_0 196 132 139  // #c4848b
            emphasis_1 107 162 121  // #6ba279
            emphasis_2 155 143 75   // #9b8f4b
            emphasis_3 255 255 255  // #ffffff
        }
        frame_unselected {
            base 184 181 188     // #b8b5bc  border
            background 0
            emphasis_0 147 88 94    // #93585e
            emphasis_1 83 123 90    // #537b5a
            emphasis_2 119 92 143   // #775c8f
            emphasis_3 0
        }
        frame_selected {
            base 91 120 165      // #5b78a5  pane.focused_border
            background 0
            emphasis_0 147 88 94    // #93585e
            emphasis_1 83 123 90    // #537b5a
            emphasis_2 119 92 143   // #775c8f
            emphasis_3 0
        }
        frame_highlight {
            base 122 104 141     // #7a688d  border.selected accent
            background 0
            emphasis_0 109 96 122   // #6d607a
            emphasis_1 119 92 143   // #775c8f
            emphasis_2 147 88 94    // #93585e
            emphasis_3 122 104 141  // #7a688d
        }
        exit_code_success {
            base 83 123 90       // #537b5a  success
            background 0
            emphasis_0 63 116 116   // #3f7474  info
            emphasis_1 29 27 29     // #1d1b1d
            emphasis_2 119 92 143   // #775c8f
            emphasis_3 91 120 165   // #5b78a5
        }
        exit_code_error {
            base 147 88 94       // #93585e  error
            background 0
            emphasis_0 135 117 65   // #877541  warning
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 122 104 141  // #7a688d
            player_2 91 120 165   // #5b78a5
            player_3 63 116 116   // #3f7474
            player_4 83 123 90    // #537b5a
            player_5 155 143 75   // #9b8f4b
            player_6 135 117 65   // #877541
            player_7 152 124 175  // #987caf
            player_8 147 88 94    // #93585e
            player_9 0
            player_10 0
        }
    }
}
